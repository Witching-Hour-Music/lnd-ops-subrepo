# lnd-ops configuration
#
# Copy to config/lnd-ops.env (gitignored) and edit, or export any of these
# in the environment. Every value below is the current production default,
# so an unedited copy reproduces existing behaviour exactly.
#
#   cp config/lnd-ops.env.example config/lnd-ops.env
#
# Resolution order for every variable: existing environment value wins,
# then config/lnd-ops.env, then the built-in default in lib/common.sh.

# ---------------------------------------------------------------------------
# Role
# ---------------------------------------------------------------------------
# local  = the workstation node
# remote = the phunkii node
LND_ROLE=local

# ---------------------------------------------------------------------------
# Binaries and paths
# ---------------------------------------------------------------------------
# Leave LNCLI unset to auto-detect: $HOME/bin/ln, then lncli/ln on PATH,
# then $HOME/go/bin/lncli. Set it explicitly to pin one.
#LNCLI=

# Path to the lnd binary, used only by scripts/install-units.sh when it
# renders lnd.service. Leave unset to auto-detect lnd on PATH.
#LND_BIN=

LND_DIR="$HOME/.lnd"
LND_WALLET_PASS_FILE="$LND_DIR/wallet.pass"
LND_SERVICE=lnd.service
LND_PEERS_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/lnd/watchdog-peers"
LND_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}"

# ---------------------------------------------------------------------------
# Health thresholds — an alert is logged when any of these is breached
# ---------------------------------------------------------------------------
# Defaults differ by role: local requires 2 active channels, remote 1.
#LND_MIN_PEERS=3
#LND_MIN_ACTIVE_CHANNELS=2
#LND_MAX_INACTIVE_CHANNELS=0

# ---------------------------------------------------------------------------
# Forwarding history window
# ---------------------------------------------------------------------------
LND_FWD_LOOKBACK="24 hours ago"
LND_FWD_MAX_EVENTS=5000

# ---------------------------------------------------------------------------
# Fee autotune
# ---------------------------------------------------------------------------
# Liquidity ladder: local balance percentage -> outbound fee in ppm.
# Read as "at or above PCT, charge PPM". Descending by PCT.
LND_FEE_LADDER="80:2 65:5 55:10 45:25 35:60 20:120 0:250"
LND_FEE_BASE_MSAT=0
LND_FEE_TIME_LOCK_DELTA=40

# Set to 0 to log intended policy changes without calling updatechanpolicy.
# scripts/preflight.sh always forces this to 0.
LND_FEE_APPLY=1

# ---------------------------------------------------------------------------
# Remote node (read by the fee-alert comparison on the local node)
# ---------------------------------------------------------------------------
# Placeholders on purpose: this file is committed, so a real user@address here
# is an SSH target published to anyone who reads the repository. Put the real
# values in config/lnd-ops.env, which is untracked.
LND_REMOTE_HOST="user@remote-node.example"
LND_REMOTE_LNCLI=/home/user/go/bin/lncli
LND_REMOTE_SSH_TIMEOUT=6
