# Template. Rendered by scripts/install.sh.
[Unit]
Description=LND (Lightning Network Daemon)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStartPre=/bin/bash -lc "test -f @LND_WALLET_PASS_FILE@"
ExecStart=@LND_BIN@ --wallet-unlock-password-file=@LND_WALLET_PASS_FILE@
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
